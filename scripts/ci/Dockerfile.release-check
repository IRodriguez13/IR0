# Tier-1 (+ optional Tier 1.5 boot) release-check image.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash \
    bison \
    build-essential \
    ca-certificates \
    curl \
    e2fsprogs \
    flex \
    git \
    grub-pc-bin \
    make \
    musl-tools \
    nasm \
    file \
    python3 \
    python3-venv \
    qemu-system-x86 \
    xorriso \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
# Bump when release-check-fresh.sh changes (invalidates COPY cache).
ARG RELEASE_CHECK_SCRIPT_REV=11
COPY scripts/ci/release-check-fresh.sh /usr/local/bin/release-check-fresh.sh
RUN chmod +x /usr/local/bin/release-check-fresh.sh

ENTRYPOINT ["/usr/local/bin/release-check-fresh.sh"]
