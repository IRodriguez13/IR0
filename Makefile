# IR0 KERNEL MAKEFILE — MULTI-ARCH SCAFFOLD (x86-64 + ARM64)
#
# Sacred entry point for all developers (including the maintainer).
# Keep this file as an index: aliases, help, wiring, and explicit includes.
# Product/profile recipes and one-shot agent dumps do NOT belong here —
# put them under scripts/make/<domain>.mk and wire with an explicit -include.
#

KERNEL_ROOT := $(CURDIR)

# Every rule this tree uses is explicit. Clearing the built-in suffix list stops
# make from searching it for the thousands of prerequisites recorded in the
# generated .d files, which costs more than parsing this Makefile. The setting
# is local to this process: recursive makes re-initialise their own list.
.SUFFIXES:
.DEFAULT_GOAL := help

# Default architecture (resolved after .config load)
ARCH ?=

# Positional modifiers: `make ir0 arm64`, `make run rpi4 console`, ...
# They are parsed here and are also declared as no-op goals at the bottom so
# make accepts them without turning them into build prerequisites.
IR0_ARCH_GOALS := x86-64 x86_64 amd64 arm64 aarch64
IR0_BOARD_GOALS := qemu-virt rpi3 rpi4 rpi5
IR0_RUN_MODES := gui console debug fullscreen gdb

IR0_GOAL_ARCH := $(firstword $(filter $(IR0_ARCH_GOALS),$(MAKECMDGOALS)))
IR0_GOAL_BOARD := $(firstword $(filter $(IR0_BOARD_GOALS),$(MAKECMDGOALS)))
IR0_RUN_MODE := $(firstword $(filter $(IR0_RUN_MODES),$(MAKECMDGOALS)))

ifneq ($(IR0_GOAL_ARCH),)
override ARCH := $(IR0_GOAL_ARCH)
endif
ifneq ($(IR0_GOAL_BOARD),)
override BOARD := $(IR0_GOAL_BOARD)
endif

CFLAGS_TARGET := -DIR0_DESKTOP


IR0_VERSION_MAJOR := 0
IR0_VERSION_MINOR := 0
IR0_VERSION_PATCH := 1
IR0_VERSION_SUFFIX :=
IR0_VERSION_STRING := $(IR0_VERSION_MAJOR).$(IR0_VERSION_MINOR).$(IR0_VERSION_PATCH)$(IR0_VERSION_SUFFIX)

# Build information is lazy and memoized: help, graph queries and unrelated
# tooling must not fork date/whoami/hostname or mutate the build stamp.
# The first consumer replaces this recursive variable with the computed value.
IR0_BUILD_META = $(eval IR0_BUILD_META := $(shell \
	stamp='$(IR0_VERSION_STRING)'; \
	old=$$(cat .build_number_version 2>/dev/null || true); \
	if [ "$$old" != "$$stamp" ]; then \
		echo 1 > .build_number; \
		printf '%s\n' "$$stamp" > .build_number_version; \
	fi; \
	printf '%s %s %s %s\n' \
		"$$(LC_TIME=C date +'%b %d %Y %H:%M:%S')" \
		"$$(whoami 2>/dev/null || echo unknown)" \
		"$$(hostname 2>/dev/null || echo localhost)" \
		"$$(cat .build_number 2>/dev/null || echo 1)"))$(IR0_BUILD_META)
IR0_BUILD_DATE = $(wordlist 1,3,$(IR0_BUILD_META))
IR0_BUILD_TIME = $(word 4,$(IR0_BUILD_META))
IR0_BUILD_USER = $(word 5,$(IR0_BUILD_META))
IR0_BUILD_HOST = $(word 6,$(IR0_BUILD_META))
# Build number - auto-increment on each kernel link (local to this workspace).
IR0_BUILD_NUMBER = $(word 7,$(IR0_BUILD_META))
# Compiler banner follows the same lazy memoization rule.
IR0_BUILD_CC = $(eval IR0_BUILD_CC := $(shell { $(CC) --version 2>/dev/null || echo "gcc unknown"; } | \
	{ read -r name ver patch rest || true; \
		printf '%s %s%s\n' "$$name" "$$ver" "$${patch:+ $$patch}"; }))$(IR0_BUILD_CC)
# Increment build number for next build (only if building kernel target)
-include .build_number_inc

# Load .config if it exists (generated by menuconfig).
# When .config is absent every CONFIG_* variable is empty and
# the ifneq(…,n) guards below default all subsystems to ON.
-include .config

CONFIG_ENABLE_USB_HOST ?= n
CONFIG_INIT_USB_HOST ?= n

# Tooling defaults from menuconfig (.config)
CONFIG_TOOL_AUTO_RUN_DEPTEST ?= n
CONFIG_TOOL_DEFAULT_DISK_FS ?= 0
CONFIG_TOOL_DEFAULT_DISK_SIZE_MB ?= 200
CONFIG_TOOL_UNIBUILD_DEFAULT_FILES ?=
CONFIG_TOOL_UNIBUILD_EXCLUDE_FILE ?=
CONFIG_ARCH_X86_64 ?= y
CONFIG_ARCH_ARM64 ?= n

ifeq ($(ARCH),)
ifeq ($(CONFIG_ARCH_ARM64),y)
ARCH := arm64
else
ARCH := x86-64
endif
endif

ifdef arch
ARCH := $(arch)
endif

# Accept userspace-style triples so a sibling `ARCH=x86_64` env/MAKEFLAGS
# does not break make (command-line ARCH requires override).
ifeq ($(ARCH),x86_64)
override ARCH := x86-64
endif
ifeq ($(ARCH),amd64)
override ARCH := x86-64
endif
ifeq ($(ARCH),aarch64)
override ARCH := arm64
endif

# BOARD only exists for ARM64. Keep qemu-virt as the default so
# `make ir0 arm64` and `make run arm64` agree without extra flags.
ifeq ($(ARCH),arm64)
BOARD ?= qemu-virt
else
BOARD :=
endif

ifeq ($(CONFIG_TOOL_DEFAULT_DISK_FS),1)
TOOL_DEFAULT_DISK_FS_NAME := fat32
else ifeq ($(CONFIG_TOOL_DEFAULT_DISK_FS),2)
TOOL_DEFAULT_DISK_FS_NAME := ext4
else
TOOL_DEFAULT_DISK_FS_NAME := minix
endif

# COMPILER CONFIGURATION (x86-64)

# Build tools
CC = gcc
LD = ld
ASM = nasm
NASM = nasm
QEMU = qemu-system-x86_64
PYTHON = python3
CROSS_COMPILE_ARM64 ?= aarch64-linux-gnu-

ifeq ($(ARCH),arm64)
CC = $(CROSS_COMPILE_ARM64)gcc
LD = $(CROSS_COMPILE_ARM64)ld
endif

# Flags
CFLAGS = -ffreestanding -nostdlib -g -Wall -Wextra -fno-stack-protector -fno-builtin
# Optimization. Without an explicit -O, GCC builds the kernel at -O0.
# The -fno-strict-* flags are required, not cosmetic: kernel code casts
# between unrelated struct types (fd payloads, VMA/file backends) and relies
# on unsigned wrap-around in size/bounds arithmetic, both of which -O2 is
# otherwise allowed to exploit. Keep frame pointers so panic dumps stay useful.
KERNEL_OPT ?= -O2
CFLAGS += $(KERNEL_OPT) -fno-strict-aliasing -fno-strict-overflow -fno-omit-frame-pointer
# Never build the kernel as PIE/PIC. With PIE, GCC keeps a PC base in %rbx and
# emits call*(%rbx+rel). A clobbered %rbx (context switch / interrupt) jumps into
# .bss — observed as #UD/#GP at current_process / fork_restore_audit (desk X).
CFLAGS += -fno-pie -fno-pic
ifeq ($(ARCH),arm64)
CFLAGS += -mgeneral-regs-only
else
CFLAGS += -m64 -mcmodel=large -mno-red-zone -mno-mmx -mno-sse -mno-sse2
endif
NASMFLAGS = -f elf64 -I$(CURDIR)/

# Directories
BUILD_DIR = build
ISO_DIR = iso

# Targets
ifeq ($(ARCH),arm64)
DEFAULT_BUILD_TARGET := kernel-arm64.bin
ifneq ($(filter rpi3 rpi4 rpi5,$(BOARD)),)
DEFAULT_BUILD_TARGET := build/arm64-$(BOARD)/kernel8.img
endif
else
DEFAULT_BUILD_TARGET := kernel-x64.iso
endif

# Portable host helpers (HOST_TMP) must load before any recipe fragment that
# expands them.
-include scripts/make/host-portable.mk

# ARM64 keeps its hermetic freestanding build graph in a fragment. Parse it
# only for an ARM64 invocation so x86 builds never pay for it.
ifeq ($(ARCH),arm64)
ARM64_BOARD := $(BOARD)
-include scripts/make/arm64.mk
-include scripts/make/arm64-board.mk
endif

all: $(DEFAULT_BUILD_TARGET)

# Public userspace ABI export (Linux `make headers_install` equivalent).
# Only includes/uapi leaves the kernel tree: a userspace package that needs a
# private kernel header is a broken boundary, not a missing include path.
UAPI_DIR = $(KERNEL_ROOT)/includes/uapi
DESTDIR ?= $(KERNEL_ROOT)

headers_install:
	@mkdir -p $(DESTDIR)/usr/include
	@cp -a $(UAPI_DIR)/. $(DESTDIR)/usr/include/
	@echo "✓ headers_install → $(DESTDIR)/usr/include ($$(find $(UAPI_DIR) -name '*.h' | wc -l) headers)"

menuconfig:
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py

menuconfig-en:
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py --set TOOL_MENUCONFIG_LANG=en >/dev/null
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py

menuconfig-es:
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py --set TOOL_MENUCONFIG_LANG=es >/dev/null
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py

defconfig:
	@cp $(KERNEL_ROOT)/setup/defconfig $(KERNEL_ROOT)/.config
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py --sync
	@echo "✓ Default configuration written to .config"
	@echo "  Run 'make menuconfig' to customize, or 'make ir0' to build."

# Merge new Kconfig symbols into .config; keeps your explicit choices.
sync-menuconfig:
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py --sync-capabilities
	@echo "✓ sync-menuconfig OK"

# Maintainer: refresh setup/defconfig after adding options to setup/Kconfig.
sync-menuconfig-defconfig:
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py --sync-capabilities --defconfig-only
	@echo "✓ sync-menuconfig-defconfig OK"

# Preview what sync would change (exit 1 if drift detected).
sync-menuconfig-check:
	@python3 $(KERNEL_ROOT)/scripts/kconfig/menuconfig.py --sync-capabilities --dry-run

CFLAGS += $(CFLAGS_TARGET)

# Include paths
CFLAGS += -I$(KERNEL_ROOT)
CFLAGS += -I$(KERNEL_ROOT)/includes
# Public userspace ABI (exported by `make headers_install`).
CFLAGS += -I$(KERNEL_ROOT)/includes/uapi
CFLAGS += -I$(KERNEL_ROOT)/ktm/include
CFLAGS += -I$(KERNEL_ROOT)/includes/ir0
CFLAGS += -I$(KERNEL_ROOT)/mm
CFLAGS += -I$(KERNEL_ROOT)/arch/common
ifeq ($(ARCH),x86-64)
CFLAGS += -I$(KERNEL_ROOT)/arch/x86-64/include
else ifeq ($(ARCH),arm64)
CFLAGS += -I$(KERNEL_ROOT)/arch/arm64/include
endif
CFLAGS += -I$(KERNEL_ROOT)/arch/arm64
CFLAGS += -I$(KERNEL_ROOT)/kernel
CFLAGS += -I$(KERNEL_ROOT)/sched
CFLAGS += -I$(KERNEL_ROOT)/drivers
CFLAGS += -I$(KERNEL_ROOT)/fs
CFLAGS += -I$(KERNEL_ROOT)/net
CFLAGS += -I$(KERNEL_ROOT)/interrupt
CFLAGS += -MMD -MP

IR0_DEBUG_PMM ?= 0
IR0_DEBUG_WAIT ?= 0
IR0_DEBUG_PROC ?= 0
CFLAGS += -DIR0_DEBUG_PMM=$(IR0_DEBUG_PMM) -DIR0_DEBUG_WAIT=$(IR0_DEBUG_WAIT) -DIR0_DEBUG_PROC=$(IR0_DEBUG_PROC)

# C++ compile flags (freestanding kernel); matches %.o: %.cpp rule
ifeq ($(ARCH),arm64)
CXX_KERNEL_FLAGS = -ffreestanding -fno-exceptions -fno-rtti -fno-threadsafe-statics \
	-nostdlib -g -Wall -Wextra -fno-stack-protector -fno-builtin
else
CXX_KERNEL_FLAGS = -m64 -ffreestanding -fno-exceptions -fno-rtti -fno-threadsafe-statics \
	-mcmodel=large -mno-red-zone -mno-mmx -mno-sse -mno-sse2 \
	-nostdlib -g -Wall -Wextra -fno-stack-protector -fno-builtin
endif
CXXFLAGS_COMPILE = $(CXX_KERNEL_FLAGS) $(CFLAGS)

# Assembler and linker flags (-I for asm_offsets.inc)
ASMFLAGS = -f elf64 -I$(CURDIR)/
LDFLAGS = -m elf_x86_64 -T arch/x86-64/linker.ld -Map=kernel-x64.map

ifeq ($(ARCH),arm64)
ASMFLAGS = -f elf64 -I$(CURDIR)/
LDFLAGS = -m aarch64elf -T arch/arm64/linker.ld -Map=kernel-arm64.map
endif


# QEMU / runtime
#
# `make run` delegates every flag to scripts/run_qemu.sh so the launcher can be
# used from any shell and never builds or touches ISD. Only the test runner
# needs the raw binary name here.
QEMU_64_CMD ?= qemu-system-x86_64
SMOKE_QEMU_RUN ?= bash scripts/smoke_qemu_run.sh
IR0_DISK ?= disk.img

