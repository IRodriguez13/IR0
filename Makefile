# BUILD RULES

# x86-64 vDSO (musl AT_SYSINFO_EHDR / __vdso_clock_gettime)
VDSO_DIR = arch/x86-64/vdso
VDSO_SO = $(VDSO_DIR)/vdso.so
VDSO_OBJ = $(VDSO_DIR)/vdso.o
VDSO_EMBED = $(VDSO_DIR)/vdso_blob_embed.o
VDSO_CFLAGS = -m64 -fPIC -fno-stack-protector -fno-builtin -nostdlib -c

$(VDSO_OBJ): $(VDSO_DIR)/vdso.S
	@echo "  AS      $< (vDSO)"
	@$(CC) $(VDSO_CFLAGS) $< -o $@

$(VDSO_SO): $(VDSO_OBJ) $(VDSO_DIR)/vdso.lds
	@echo "  LD      $@ (vDSO)"
	@$(LD) -m elf_x86_64 -shared -nostdlib -T $(VDSO_DIR)/vdso.lds -o $@ $(VDSO_OBJ)

$(VDSO_EMBED): $(VDSO_SO)
	@echo "  OBJCOPY $< → $@"
	@cd $(VDSO_DIR) && objcopy -I binary -O elf64-x86-64 -B i386:x86-64 \
		--rename-section .data=.rodata,alloc,load,readonly,data,contents \
		--add-section .note.GNU-stack=/dev/null \
		--set-section-flags .note.GNU-stack=noload,readonly \
		vdso.so vdso_blob_embed.o

# Compile C files
%.o: %.c
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) \
		-DIR0_BUILD_DATE_STRING="\"$(IR0_BUILD_DATE)\"" \
		-DIR0_BUILD_TIME_STRING="\"$(IR0_BUILD_TIME)\"" \
		-DIR0_BUILD_USER_STRING="\"$(IR0_BUILD_USER)\"" \
		-DIR0_BUILD_HOST_STRING="\"$(IR0_BUILD_HOST)\"" \
		-DIR0_BUILD_CC_STRING="\"$(IR0_BUILD_CC)\"" \
		-DIR0_BUILD_NUMBER_STRING="\"$(IR0_BUILD_NUMBER)\"" \
		-c $< -o $@

# Compile C++ files
%.o: %.cpp
	@echo "  CXX     $<"
	@g++ $(CXXFLAGS_COMPILE) -c $< -o $@

# Compile Rust files (using unibuild script)
%.o: %.rs
	@echo "  RUST    $<"
	@$(KERNEL_ROOT)/scripts/unibuild.sh -rust $<

# Compile ASM files
%.o: %.asm
	@echo "  ASM     $<"
	@$(ASM) $(ASMFLAGS) $< -o $@

ifeq ($(ARCH),arm64)
%.o: %.S
	@echo "  AS      $<"
	@$(CC) $(CFLAGS) -c $< -o $@

arch/arm64/asm/context/switch_early.o: arch/arm64/asm/context/switch_early.S
	@echo "  AS      $<"
	@$(CC) $(CFLAGS) -c $< -o $@
endif


# Link kernel
kernel-x64.bin: $(ALL_OBJS) arch/x86-64/linker.ld
	@echo "  LD      $@"
	@$(LD) $(LDFLAGS) --defsym=ir0_build_number=$(IR0_BUILD_NUMBER) -o $@ $(ALL_OBJS)
	@echo "✓ Kernel linked: $@"
	@echo "$(IR0_BUILD_NUMBER)" > .kernel_build_number
	@echo "  BUILD   Incrementing build number..."
	@if [ -f .build_number ]; then \
		BUILD_NUM=$$(cat .build_number); \
		BUILD_NUM=$$((BUILD_NUM + 1)); \
		echo $$BUILD_NUM > .build_number; \
	else \
		echo "1" > .build_number; \
	fi

# ARM64 public image: same portable link as kernel-arm64-product.bin (validated
# by arm64-common-core-compile + arm64-provider-audit).
kernel-arm64.bin: kernel-arm64-product.bin arm64-common-core-compile arm64-provider-audit
	@echo "  COPY    $@ (ARM64 product kernel)"
	@cp kernel-arm64-product.bin $@
	@echo "  OBJCOPY kernel-arm64.img (Linux Image; QEMU sets x0 to the DTB)"
	@aarch64-linux-gnu-objcopy -O binary $@ kernel-arm64.img
	@echo "✓ Kernel image ready: $@"

# Portable ARM64 kernel: same ir0_kernel_boot chain as x86 (no IR0_FREESTANDING_BOOT).
# `make kernel-arm64-product.bin` forces ARCH=arm64 via goal detection.
kernel-arm64-product.bin: $(ALL_OBJS) arch/arm64/linker.ld
	@echo "  LD      $@"
	@$(KERNEL_ARM64_PRODUCT_LINK_CMD) $(KERNEL_ARM64_PRODUCT_LINK_FLAGS) \
		-Wl,--defsym,ir0_build_number=$(IR0_BUILD_NUMBER) -o $@ $(ALL_OBJS) -lgcc
	@echo "✓ Kernel linked: $@"
	@echo "  OBJCOPY kernel-arm64-product.img (Linux Image; QEMU sets x0 to the DTB)"
	@aarch64-linux-gnu-objcopy -O binary $@ kernel-arm64-product.img

# Raspberry Pi firmware loads a raw kernel8.img at 0x80000.
ifneq ($(filter rpi3 rpi4 rpi5,$(BOARD)),)
build/arm64-$(BOARD)/kernel8.img: kernel-arm64-$(BOARD)-min.bin
	@mkdir -p $(@D)
	@echo "  OBJCOPY $< → $@"
	@aarch64-linux-gnu-objcopy -O binary $< $@
	@echo "✓ Board image ready: $@"
endif

# Create ISO
kernel-x64.iso: kernel-x64.bin arch/x86-64/grub.cfg
	@echo "  ISO     $@"
	@rm -rf iso
	@mkdir -p iso/boot/grub
	@cp arch/x86-64/grub.cfg iso/boot/grub/
	@cp kernel-x64.bin iso/boot/
	@echo "Running grub-mkrescue (will print errors if it fails)..."
	@grub-mkrescue -o $@ iso
	@echo "✓ ISO created: $@"

# linux-abi-audit, kmang, and tier-1 smokes use this historical name.
kernel-x64-userspace.iso: kernel-x64.iso
	@ln -sfn kernel-x64.iso $@
	@echo "✓ $@ → kernel-x64.iso (rescue ISO with current kernel-x64.bin)"

# Kernel con tests in-kernel (solo al hacer make tests / kernel-tests)
# config.h documents IR0_KERNEL_TESTS; Makefile ensures it for this target.
# kmain must be compiled with that flag: a leftover kernel-x64.bin main.o
# would skip kernel_test_run_all() and make kernel-tests time out.
kernel-x64-test.bin: $(ALL_OBJS_TEST) arch/x86-64/linker.ld
	@echo "  LD      $@ (with in-kernel tests)"
	@$(LD) $(LDFLAGS) --defsym=ir0_build_number=$(IR0_BUILD_NUMBER) -o $@ $(ALL_OBJS_TEST)
	@echo "✓ Kernel (test) linked: $@"

build/test/arch/common/%.o: arch/common/%.c
