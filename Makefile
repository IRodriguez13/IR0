# make cannot see CFLAGS changes. Depend on the Makefile so editing a flag
# cannot leave a mixed object tree (e.g. -O0 and -O2 objects in one link).
$(ALL_OBJS) $(ALL_OBJS_TEST): $(KERNEL_ROOT)/Makefile

# BUILD RULES

# x86-64 vDSO (musl AT_SYSINFO_EHDR / __vdso_clock_gettime)
VDSO_DIR = arch/x86-64/vdso
VDSO_SO = $(VDSO_DIR)/vdso.so
VDSO_OBJ = $(VDSO_DIR)/vdso.o
VDSO_EMBED = $(VDSO_DIR)/vdso_blob_embed.o
VDSO_CFLAGS = -m64 -fPIC -fno-stack-protector -fno-builtin -nostdlib -c

$(VDSO_OBJ): $(VDSO_DIR)/vdso.S
	@echo "  AS      $< (vDSO)"
	@$(CC) $(VDSO_CFLAGS) $< -o $@

$(VDSO_SO): $(VDSO_OBJ) $(VDSO_DIR)/vdso.lds
	@echo "  LD      $@ (vDSO)"
	@$(LD) -m elf_x86_64 -shared -nostdlib -T $(VDSO_DIR)/vdso.lds -o $@ $(VDSO_OBJ)

$(VDSO_EMBED): $(VDSO_SO)
	@echo "  OBJCOPY $< → $@"
	@cd $(VDSO_DIR) && objcopy -I binary -O elf64-x86-64 -B i386:x86-64 \
		--rename-section .data=.rodata,alloc,load,readonly,data,contents \
		--add-section .note.GNU-stack=/dev/null \
		--set-section-flags .note.GNU-stack=noload,readonly \
		vdso.so vdso_blob_embed.o

# Compile C files
%.o: %.c
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) \
		-DIR0_BUILD_DATE_STRING="\"$(IR0_BUILD_DATE)\"" \
		-DIR0_BUILD_TIME_STRING="\"$(IR0_BUILD_TIME)\"" \
		-DIR0_BUILD_USER_STRING="\"$(IR0_BUILD_USER)\"" \
		-DIR0_BUILD_HOST_STRING="\"$(IR0_BUILD_HOST)\"" \
		-DIR0_BUILD_CC_STRING="\"$(IR0_BUILD_CC)\"" \
		-DIR0_BUILD_NUMBER_STRING="\"$(IR0_BUILD_NUMBER)\"" \
		-c $< -o $@

# Compile C++ files
%.o: %.cpp
	@echo "  CXX     $<"
	@g++ $(CXXFLAGS_COMPILE) -c $< -o $@

# Compile Rust files (using unibuild script)
%.o: %.rs
	@echo "  RUST    $<"
	@$(KERNEL_ROOT)/scripts/unibuild.sh -rust $<

# Compile ASM files
%.o: %.asm
	@echo "  ASM     $<"
	@$(ASM) $(ASMFLAGS) $< -o $@

ifeq ($(ARCH),arm64)
%.o: %.S
	@echo "  AS      $<"
	@$(CC) $(CFLAGS) -c $< -o $@

arch/arm64/asm/context/switch_early.o: arch/arm64/asm/context/switch_early.S
	@echo "  AS      $<"
	@$(CC) $(CFLAGS) -c $< -o $@
endif


# Link kernel
kernel-x64.bin: $(ALL_OBJS) arch/x86-64/linker.ld
	@echo "  LD      $@"
	@$(LD) $(LDFLAGS) --defsym=ir0_build_number=$(IR0_BUILD_NUMBER) -o $@ $(ALL_OBJS)
	@echo "✓ Kernel linked: $@"
	@echo "$(IR0_BUILD_NUMBER)" > .kernel_build_number
	@echo "  BUILD   Incrementing build number..."
	@if [ -f .build_number ]; then \
		BUILD_NUM=$$(cat .build_number); \
		BUILD_NUM=$$((BUILD_NUM + 1)); \
		echo $$BUILD_NUM > .build_number; \
	else \
		echo "1" > .build_number; \
	fi

# ARM64 public image: the validated aggregate contains the common MM/process
# slice and no allocator/runtime/link mocks or weak providers. Early syscall
# and rootfs providers remain staged.
kernel-arm64.bin: kernel-arm64-all.bin arm64-common-core-compile arm64-provider-audit
	@echo "  COPY    $@ (validated ARM64 aggregate)"
	@cp kernel-arm64-all.bin $@
	@echo "✓ Kernel linked: $@ (common-core aggregate; early providers remain)"

# Raspberry Pi firmware loads a raw kernel8.img at 0x80000.
ifneq ($(filter rpi3 rpi4 rpi5,$(BOARD)),)
build/arm64-$(BOARD)/kernel8.img: kernel-arm64-$(BOARD)-min.bin
	@mkdir -p $(@D)
	@echo "  OBJCOPY $< → $@"
	@aarch64-linux-gnu-objcopy -O binary $< $@
	@echo "✓ Board image ready: $@"
endif

# Create ISO
kernel-x64.iso: kernel-x64.bin arch/x86-64/grub.cfg
	@echo "  ISO     $@"
	@rm -rf iso
	@mkdir -p iso/boot/grub
	@cp arch/x86-64/grub.cfg iso/boot/grub/
	@cp kernel-x64.bin iso/boot/
	@echo "Running grub-mkrescue (will print errors if it fails)..."
	@grub-mkrescue -o $@ iso
	@echo "✓ ISO created: $@"

# Kernel con tests in-kernel (solo al hacer make tests / kernel-tests)
# config.h documents IR0_KERNEL_TESTS; Makefile ensures it for this target.
# kmain must be compiled with that flag: a leftover kernel-x64.bin main.o
# would skip kernel_test_run_all() and make kernel-tests time out.
kernel-x64-test.bin: $(ALL_OBJS_TEST) arch/x86-64/linker.ld
	@echo "  LD      $@ (with in-kernel tests)"
	@$(LD) $(LDFLAGS) --defsym=ir0_build_number=$(IR0_BUILD_NUMBER) -o $@ $(ALL_OBJS_TEST)
	@echo "✓ Kernel (test) linked: $@"

build/test/kernel/%.o: kernel/%.c
	@mkdir -p $(@D)
	@echo "  CC      $< (test variant)"
	@$(CC) $(CFLAGS) -DIR0_KERNEL_TESTS=1 \
		-DIR0_BUILD_DATE_STRING="\"$(IR0_BUILD_DATE)\"" \
		-DIR0_BUILD_TIME_STRING="\"$(IR0_BUILD_TIME)\"" \
		-DIR0_BUILD_USER_STRING="\"$(IR0_BUILD_USER)\"" \
		-DIR0_BUILD_HOST_STRING="\"$(IR0_BUILD_HOST)\"" \
		-DIR0_BUILD_CC_STRING="\"$(IR0_BUILD_CC)\"" \
		-DIR0_BUILD_NUMBER_STRING="\"$(IR0_BUILD_NUMBER)\"" \
		-c $< -o $@

kernel-x64-test.iso: kernel-x64-test.bin arch/x86-64/grub.cfg
	@echo "  ISO     $@"
	@rm -rf iso_test
	@mkdir -p iso_test/boot/grub
	@cp arch/x86-64/grub.cfg iso_test/boot/grub/
	@cp kernel-x64-test.bin iso_test/boot/kernel-x64.bin
	@grub-mkrescue -o $@ iso_test
	@rm -rf iso_test
	@echo "✓ ISO (test) created: $@"

# Create a raw disk image used by QEMU. If you want a persistent filesystem
# you can format and populate this image separately. This target will
# create a raw disk image if it doesn't already exist.
# Supports filesystem selection via FS=minix|fat16|fat32|ext4 and size via SIZE=MB (legacy)
# For new usage, use: make create-disk FS=minix SIZE=200
disk.img:
	@if [ -f $@ ]; then \
		echo "  DISK    $@ already exists"; \
	else \
		echo "  DISK    creating $@ using scripts/create_disk.sh"; \
		if [ -n "$(FS)" ]; then \
			if [ -n "$(SIZE)" ]; then \
				./scripts/create_disk.sh $(FS) $(SIZE) --output $@; \
			else \
				./scripts/create_disk.sh $(FS) --output $@; \
			fi; \
		else \
			./scripts/create_disk.sh --output $@; \
		fi; \
	fi
	@echo "✓ Disk image ready: $@"

# ============================================
# BUILD CONFIGURATION
# ============================================

# Parallel jobs: default to all CPU cores (override: make -j1 or PARALLEL_JOBS=1).
# getconf is POSIX; sysctl covers BSD/macOS where nproc does not exist.
NPROC := $(shell getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
PARALLEL_JOBS ?= $(NPROC)

# Top-level invocations compile object files in parallel unless -j is already set.
ifeq ($(MAKELEVEL), 0)
  ifeq ($(filter -j%,$(MAKEFLAGS)),)
    MAKEFLAGS += -j$(PARALLEL_JOBS)
  endif
endif

# ARCH is already set at the top of the file

# Process architecture parameter and .config selection.
ifneq ($(filter $(ARCH),x86-64 arm64),$(ARCH))
$(error Unsupported architecture: $(ARCH). Valid values: x86-64, arm64 (aliases: x86_64, aarch64))
endif

ifeq ($(CONFIG_ARCH_X86_64),y)
CFLAGS += -DCONFIG_ARCH_X86_64=1
else
CFLAGS += -DCONFIG_ARCH_X86_64=0
endif

ifeq ($(CONFIG_ARCH_ARM64),y)
CFLAGS += -DCONFIG_ARCH_ARM64=1
else
CFLAGS += -DCONFIG_ARCH_ARM64=0
endif

ifeq ($(ARCH),x86-64)
CFLAGS += -DARCH_X86_64 -DARCH_X86
QEMU = qemu-system-x86_64
else
CFLAGS += -DARCH_ARM64
QEMU = qemu-system-aarch64
endif

# ============================================
# BUILD TARGETS
# ============================================

# `ir0` is the single build entry point. It compiles with -Werror and selects
# the artifact from ARCH/BOARD: x86 ISO, ARM64 aggregate, or board kernel8.img.
ir0: CFLAGS += -Werror

ifeq ($(CONFIG_TOOL_AUTO_RUN_DEPTEST),y)
IR0_PRECHECK_TARGETS := deptest
else
IR0_PRECHECK_TARGETS :=
endif

ir0: $(IR0_PRECHECK_TARGETS) $(DEFAULT_BUILD_TARGET)

# ============================================
# RUN
# ============================================

# `run` only launches an artifact that is already on disk. The launcher
# resolves ARCH/BOARD and refuses to start if the product is missing; it never
# invokes make and never touches ISD.
#
#   make run                 GUI (x86) / serial (ARM64)
#   make run console         -nographic
#   make run debug           QEMU guest-error/int log + monitor
#   make run fullscreen      GTK full screen
#   make run gdb             wait for GDB on localhost:1234
#   make run arm64 rpi4      board image under build/arm64-rpi4/
RUN_MODE := $(or $(IR0_RUN_MODE),gui)

run:
	@ARCH="$(ARCH)" BOARD="$(BOARD)" ./scripts/run_qemu.sh $(RUN_MODE)

# Historical mode names remain valid shortcuts (`make debug` == run debug).
.PHONY: gui console debug fullscreen gdb
gui console debug fullscreen gdb: run

# Create disk image (wrapper for scripts/create_disk.sh)
# Usage: make create-disk [FS=minix] [SIZE=200]
# Examples:
#   make create-disk              # Create 200MB MINIX disk (default)
#   make create-disk FS=minix SIZE=500
#   make create-disk FS=fat32
#   make create-disk FS=ext4 SIZE=1000
create-disk:
	@./scripts/create_disk.sh "$(or $(FS),$(TOOL_DEFAULT_DISK_FS_NAME))" \
		"$(or $(SIZE),$(CONFIG_TOOL_DEFAULT_DISK_SIZE_MB))"
	@echo "Disk image is ready"

# Delete disk image (useful to reset persistent disk for QEMU)
# Usage: make delete-disk [FS=minix] [DISK=disk.img]
# Examples:
#   make delete-disk              # Delete disk.img (default)
#   make delete-disk FS=minix
#   make delete-disk FS=fat32 DISK=fat32.img
delete-disk:
	@./scripts/delete_disk.sh $(FS) $(DISK)

# Reset dev disk + inject stamps (explicit wipe; ignores IR0_DEV_PERSIST).
disk-reset:
	@DISK=$${DISK:-$(IR0_DISK)}; \
	./scripts/delete_disk.sh $$DISK; \
	rm -f $$DISK.runit.stamp $$DISK.devtools.stamp; \
	echo "✓ disk-reset: $$DISK + inject stamps cleared"

# Load Init binary into virtual disk
# Usage: make load-init [FS=minix] [DISK=disk.img] [INIT=setup/pid1/init]
# Defaults: filesystem=auto-detect, disk_image=disk.img, init_binary=setup/pid1/init
# Supported filesystems: minix, fat16, fat32, ext4
# Note: Requires root privileges (mounts filesystem)
# Examples:
#   sudo make load-init                    # Auto-detect, use disk.img
#   sudo make load-init FS=fat32
#   sudo make load-init FS=fat32 DISK=fat32.img
load-init:
	@./scripts/load_init.sh $(FS) $(DISK) $(INIT)

# Focused target fragments. Each one is small and always parsed; the old QA
# catalog is gone, so every goal stays in the same fast parse path.
-include scripts/make/docs.mk
-include scripts/make/ktm.mk
-include scripts/make/clean.mk

.PHONY: arch-guard
arch-guard:
	@python3 $(KERNEL_ROOT)/scripts/architecture_guard.py

# Host↔guest clipboard via 9p dennis (.ir0/clipboard → guest ir0-paste)
.PHONY: clip-send clip-pull clip-status
IR0_CLIP_DIR = $(KERNEL_ROOT)/.ir0/clipboard

clip-send:
	@chmod +x scripts/ir0-clip.sh
	@scripts/ir0-clip.sh send

clip-pull:
	@chmod +x scripts/ir0-clip.sh
	@scripts/ir0-clip.sh pull

clip-status:
	@chmod +x scripts/ir0-clip.sh
	@scripts/ir0-clip.sh status


# HELP

# DEV TOOLING

format:
	@echo "  FMT     Formatting *.c *.h ..."
	@find . \( -name "*.c" -o -name "*.h" \) \
		-not -path "./setup/*" -not -path "./build/*" -not -path "./.git/*" \
		| xargs clang-format -i
	@echo "✓ Format done"

# Análisis estático con cppcheck (opcional).
analyze:
	@if command -v cppcheck >/dev/null 2>&1; then \
		echo "  CPPCHECK --enable=warning,style --quiet ..."; \
		cppcheck --enable=warning,style --quiet -i.git -iiso -iiso_test .; \
	else \
		echo "cppcheck is not installed; skipping static analysis."; \
		echo "Install cppcheck to enable this target (e.g. apt install cppcheck, dnf install cppcheck, pacman -S cppcheck, brew install cppcheck)."; \
	fi

compile-commands:
	@echo "  CC_JSON Generating compile_commands.json ..."
	@echo "[" > compile_commands.json
	@first=true; count=0; \
	for src in $(patsubst %.o,%.c,$(filter %.o,$(ALL_OBJS))); do \
		if [ -f "$$src" ]; then \
			if [ "$$first" = true ]; then first=false; else echo "," >> compile_commands.json; fi; \
			printf '  { "directory": "%s", "file": "%s", "command": "%s %s -c %s" }' \
				"$(CURDIR)" "$$src" "$(CC)" "$(CFLAGS)" "$$src" >> compile_commands.json; \
			count=$$((count + 1)); \
		fi; \
	done; \
	for src in $(patsubst %.o,%.cpp,$(filter %.o,$(ALL_OBJS))); do \
		if [ -f "$$src" ]; then \
			if [ "$$first" = true ]; then first=false; else echo "," >> compile_commands.json; fi; \
			printf '  { "directory": "%s", "file": "%s", "command": "%s %s -c %s" }' \
				"$(CURDIR)" "$$src" "g++" "$(CXXFLAGS_COMPILE)" "$$src" >> compile_commands.json; \
			count=$$((count + 1)); \
		fi; \
	done; \
	echo "" >> compile_commands.json; \
	echo "]" >> compile_commands.json; \
	echo "✓ compile_commands.json generated ($$count entries)"

.PHONY: print-build-objects build-graph-audit

# Machine-readable expansion for build tooling. Keep this free of formatting.
print-build-objects:
	@printf '%s\n' "$(ALL_OBJS)"

# Detect list drift before refactoring Makefile source sets or architecture wiring.
build-graph-audit:
	@$(PYTHON) scripts/build_graph_audit.py --root "$(KERNEL_ROOT)" --make "$(MAKE)"

disasm: kernel-x64.bin
	@echo "  OBJDUMP kernel-x64.disasm ..."
	@objdump -d -S kernel-x64.bin > kernel-x64.disasm
	@echo "✓ Disassembly: kernel-x64.disasm ($(shell wc -l < kernel-x64.disasm 2>/dev/null || echo ?) lines)"

stack-usage:
	@echo "  STACK   Rebuilding with -fstack-usage ..."
	@$(MAKE) clean
	@$(MAKE) CFLAGS="$(CFLAGS) -fstack-usage" kernel-x64.bin
	@echo ""
	@echo "Top 30 stack consumers:"
	@echo "-----------------------------------------------"
	@find . -name "*.su" -exec cat {} + 2>/dev/null | sort -t: -k3 -rn | head -30
	@echo ""

