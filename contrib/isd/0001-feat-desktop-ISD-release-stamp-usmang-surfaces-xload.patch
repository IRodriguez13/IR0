@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-3.0-only
+# Emit first-party / third-party package classification for a profile.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+ORIGINS="${ROOT}/scripts/package-origins.txt"
+OUT="${1:?usage: write-package-manifest.sh <dest-file>}"
+MANIFEST="${ISD_PACKAGES_MANIFEST:-}"
+
+if [ -z "$MANIFEST" ]; then
+	MANIFEST="$(PROFILE="${PROFILE:-minimal}" bash "${ROOT}/scripts/resolve-packages.sh")"
+fi
+
+mkdir -p "$(dirname "$OUT")"
+{
+	echo "# ISD package manifest — origins are independent of IR0 kernel build #N"
+	echo "# USERLAND_BASE=${USERLAND_BASE:-busybox}"
+	echo "# PROFILE=${PROFILE:-unknown} ARCH=${ARCH:-unknown}"
+	for pkg in $MANIFEST; do
+		origin="third-party"
+		if [ -f "$ORIGINS" ]; then
+			line="$(awk -v p="$pkg" '$1 == p { print $2; exit }' "$ORIGINS" || true)"
+			[ -n "$line" ] && origin="$line"
+		fi
+		# First-party services are not packages/; annotate core glue.
+		printf '%s\t%s\n' "$pkg" "$origin"
+	done
+	echo "# first-party-services	runit stages, ir0-firstboot, ir0-status, fsck.ir0, …"
+} >"$OUT"
