#
# Filesystem registry. Each filesystem lives in fs/<name>/ and has one
# fragment, scripts/make/fs/<name>.mk, that adds its objects to fs-obj-y and
# its struct vfs_fstype to fs-type-y when .config enables it (Kbuild
# obj-$(CONFIG_...) style). Adding a filesystem is a directory, a fragment
# and an entry in FILESYSTEMS; the VFS core is never edited for it.
#
# FILESYSTEMS is the registration order, which /proc/filesystems follows
# (proc, registered by the VFS core, comes first).

FILESYSTEMS := tmpfs minix simplefs fat16 ext2 9p

fs-obj-y :=
fs-type-y :=
include $(foreach fs,$(FILESYSTEMS),$(KERNEL_ROOT)/scripts/make/fs/$(fs).mk)

# <generated/filesystems.h> defines IR0_FILESYSTEMS(fs), one fs(type) per
# selected type, which fs/filesystems.c expands into the table vfs_init()
# registers. It is rewritten at parse time only when the selection changes,
# so the -MMD dependency of fs/filesystems.o rebuilds the table exactly then.
FS_TABLE := $(KERNEL_ROOT)/includes/generated/filesystems.h

define fs-nl


endef
fs-space := $(subst ,, )
fs-hash := \#
fs-table-entries := $(strip $(foreach type,$(fs-type-y),fs($(type))))
FS_TABLE_TEXT := /* Generated by scripts/make/fs.mk from .config: the built-in filesystem types, in registration order. */$(fs-nl)$(fs-hash)define IR0_FILESYSTEMS(fs) \$(fs-nl)$(subst $(fs-space), \$(fs-nl),$(fs-table-entries)) \$(fs-nl)/* end of IR0_FILESYSTEMS */

ifneq ($(FS_TABLE_TEXT),$(file <$(FS_TABLE)))
$(shell mkdir -p $(dir $(FS_TABLE)))
$(file >$(FS_TABLE),$(FS_TABLE_TEXT))
endif
